# EditorConfig -- https://editorconfig.org
# Supports the docs character-set convention: UTF-8, LF, final newline, no BOM.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Markdown: keep trailing spaces (two-space hard line breaks are meaningful).
[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2
